# Production image. The development Dockerfile installs pytest, httpx and
# ruff because it is bind-mounted and used for running the suite; none of
# that belongs in a deployed artifact, and ECR's free tier is 500 MB.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY pyproject.toml ./
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -e . \
 && find /usr/local -name '__pycache__' -type d -exec rm -rf {} + 2>/dev/null || true

COPY cashmatch ./cashmatch
COPY alembic ./alembic
COPY alembic.ini ./
COPY config ./config
COPY entrypoint.sh ./
RUN chmod +x entrypoint.sh

# The seeded demo dataset is written here and the volume outlives a
# container restart.
RUN mkdir -p /data && useradd --create-home --uid 1000 appuser \
 && chown -R appuser:appuser /app /data
USER appuser

EXPOSE 8000

# Migrations and seeding happen in the entrypoint, because a managed platform
# gives you one process and no shell during a deploy.
CMD ["./entrypoint.sh"]
