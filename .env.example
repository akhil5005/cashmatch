# ---------------------------------------------------------------------------
# CashMatch configuration. Copy to `.env` and adjust.
# Every value below is a safe default: the project runs with no edits at all.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# These three are consumed by the `db` service in docker-compose.yml.
POSTGRES_USER=cashmatch
POSTGRES_PASSWORD=cashmatch
POSTGRES_DB=cashmatch

# Connection string used by the API. Inside Docker the host is the service
# name `db`; running the API on your host machine instead, use `localhost`.
DATABASE_URL=postgresql+psycopg://cashmatch:cashmatch@db:5432/cashmatch

# --- Reproducibility -------------------------------------------------------
# Seeds every random choice in the synthetic data generator (Phase 2).
# The same seed always produces byte-identical data.
RANDOM_SEED=42

# --- Data locations --------------------------------------------------------
# Where the generator writes documents and the ground-truth answer key.
# Inside Docker this is /data; on the host it defaults to ./data.
DATA_DIR=./data

# Scenario mix and dataset volume for `cashmatch generate`.
SCENARIO_CONFIG=./backend/config/scenarios.yml

# --- LLM (Phase 4) ---------------------------------------------------------
# mock : deterministic canned extraction. No network, no key. Tests use this.
# live : call the Google Gemini API. Requires GEMINI_API_KEY.
# off  : skip the LLM entirely and use the regex fallback extractor.
LLM_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
